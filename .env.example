# ============================================================================
# .env.example
#
# Copy this file to .env and fill in real values for your local machine.
# .env is git-ignored and must NEVER be committed.
#
# This file intentionally contains placeholders only — no real credentials.
#
# Every variable below is checked against the actual settings classes that
# read it by tests/unit/test_config_env_consistency.py (added Step 15) —
# a variable disappearing from here (or the code reading a different name
# than what's documented, as happened once with DB_POOL_MAX_OVERFLOW) will
# fail that test rather than fail silently in production.
# ============================================================================

# --- Application environment (job_market_intel.common.config.Settings) -------
# development | staging | production
APP_ENV=development

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- PostgreSQL (job_market_intel.db.config — NOT part of common.config.Settings,
#     see that module's docstring for why) --------------------------------------
# Full SQLAlchemy-style DSN. Takes precedence over the DB_HOST/etc. parts
# below if both are set.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://jmi_app_user:changeme@localhost:5432/job_market_intelligence

# Alternative to DATABASE_URL: individual components, assembled into a DSN
# if DATABASE_URL is not set.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=job_market_intelligence
# DB_USER=jmi_app_user
# DB_PASSWORD=changeme

# Connection pool tuning — all optional, shown with their defaults.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true
# DB_ECHO=false
# DB_APPLICATION_NAME=job_market_intelligence

# --- RemoteOK scraper (job_market_intel.scrapers.remoteok.config.RemoteOKSettings) ---
# All optional — the scraper works out-of-the-box with no entries here.
# REMOTEOK_API_URL=https://remoteok.com/api
# REMOTEOK_REQUEST_TIMEOUT_SECONDS=15.0
# REMOTEOK_MAX_RETRY_ATTEMPTS=4
# REMOTEOK_RETRY_INITIAL_WAIT_SECONDS=1.0
# REMOTEOK_RETRY_MAX_WAIT_SECONDS=30.0
# REMOTEOK_USER_AGENT=JobMarketIntelligencePlatform-Research/1.0 (+https://example-research-project.local)

# --- RemoteOK validation thresholds (job_market_intel.validation.remoteok_validator.RemoteOKValidationSettings) ---
# REMOTEOK_VALIDATION_MIN_EXPECTED_JOBS=20
# REMOTEOK_VALIDATION_MAX_SKIP_RATE=0.10

# --- Indeed scraper (job_market_intel.scrapers.indeed.config.IndeedSettings) -------
# All optional — the scraper works out-of-the-box with these (confirmed-
# during-scoping) defaults. See config.py's own docstring for the reasoning
# behind each default, not just its value.
# INDEED_BASE_URL=https://www.indeed.com
# INDEED_HEADLESS=false
# INDEED_PAGE_ACTION_MIN_WAIT_SECONDS=4.0
# INDEED_PAGE_ACTION_MAX_WAIT_SECONDS=9.0
# INDEED_LONG_PAUSE_EVERY_N_PAGES=5
# INDEED_LONG_PAUSE_MIN_SECONDS=45.0
# INDEED_LONG_PAUSE_MAX_SECONDS=90.0
# INDEED_MAX_SEARCH_PAGES_PER_SESSION=5
# INDEED_MAX_DETAIL_PAGES_PER_SESSION=60
# INDEED_MAX_CONSECUTIVE_FAILURES=3
# INDEED_PAGE_LOAD_TIMEOUT_SECONDS=30.0
# INDEED_ITEMS_PER_RUN=10
# Leave UC on (the default) everywhere except the self-hosted CI runner, where
# it hangs; the Indeed CI step in .github/workflows/scrape.yml sets this false.
# INDEED_UC_ENABLED=true
# Bound on the browser session handshake, not on page loads — raise it on
# slow/small machines, where a cold Chrome can take a minute to answer the
# driver's first request at all.
# INDEED_SESSION_START_TIMEOUT_SECONDS=300.0
# INDEED_INTER_ITEM_PAUSE_MIN_SECONDS=30.0
# INDEED_INTER_ITEM_PAUSE_MAX_SECONDS=90.0
# INDEED_REQUEST_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# --- Indeed validation thresholds (job_market_intel.validation.indeed_validator.IndeedValidationSettings) ---
# INDEED_VALIDATION_MIN_EXPECTED_JOBS=3
# INDEED_VALIDATION_MAX_SKIP_RATE=0.20

# --- Scheduler (job_market_intel.scheduler.config.SchedulerSettings) ---------
# How often scripts/run_scheduler.py runs the RemoteOK pipeline, in hours.
SCHEDULER_SCRAPE_INTERVAL_HOURS=12
# SCHEDULER_RUN_IMMEDIATELY_ON_START=true
# SCHEDULER_MISFIRE_GRACE_TIME_SECONDS=3600
# SCHEDULER_COALESCE_MISSED_RUNS=true

# How often scripts/run_scheduler.py (or its Indeed equivalent, once wired
# up — not yet done by this delivery, see the accompanying chat message)
# runs the Indeed pipeline, in hours. Confirmed decision from scoping this
# scraper: every 12 hours, same cadence as RemoteOK.
# SCHEDULER_INDEED_SCRAPE_INTERVAL_HOURS=12

# ============================================================================
# The following are reserved for genuinely FUTURE steps and are not read by
# any code yet. Left here only so collaborators know they're coming, and
# excluded from the Step 15 env-var consistency check for that reason.
# ============================================================================

# Partition maintenance and materialized-view refresh are separate,
# not-yet-built scheduled jobs (see workflow doc) - reserved here so their
# env vars land in the same place once they exist.
# SCHEDULER_PARTITION_MAINTENANCE_CRON=
# SCHEDULER_MV_REFRESH_CRON=

# --- API (Step 34) ---
# API_HOST=
# API_PORT=
# API_SECRET_KEY=

# --- Dashboard (Step 29) ---
# DASHBOARD_PORT=

# --- Reed scraper (job_market_intel.scrapers.reed.config.ReedSettings) -------------
# REED_API_KEY has NO default and is REQUIRED -- unlike every other source
# here, the scraper will refuse to start without it. Register for free at
# https://www.reed.co.uk/developers/jobseeker and paste your key below.
# Sent as HTTP Basic Auth username (blank password) on every request --
# see config.py's own docstring for why Reed needs this and no other
# source does.
REED_API_KEY=your-reed-api-key-here
# Everything else is optional -- see config.py's own docstring for the
# reasoning behind each default (particularly REED_MAX_JOBS_PROCESSED_PER_RUN,
# which exists because Reed has no documented daily request ceiling).
# REED_SEARCH_URL=https://www.reed.co.uk/api/1.0/search
# REED_DETAILS_URL=https://www.reed.co.uk/api/1.0/jobs
# REED_RESULTS_PER_PAGE=100
# REED_MAX_SEARCH_PAGES_PER_QUERY=10
# REED_MAX_JOBS_PROCESSED_PER_RUN=200
# REED_REQUEST_TIMEOUT_SECONDS=15.0
# REED_MAX_RETRY_ATTEMPTS=4
# REED_RETRY_INITIAL_WAIT_SECONDS=1.0
# REED_RETRY_MAX_WAIT_SECONDS=30.0
# REED_USER_AGENT=JobMarketIntelligencePlatform-Research/1.0 (+https://example-research-project.local)

# --- Reed validation thresholds (job_market_intel.validation.reed_validator.ReedValidationSettings) ---
# REED_VALIDATION_MIN_EXPECTED_JOBS=1
# REED_VALIDATION_MAX_SKIP_RATE=0.10
# REED_QUERIES_CLAIMED_PER_RUN=5
