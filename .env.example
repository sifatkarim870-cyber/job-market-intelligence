# ============================================================================
# .env.example
#
# Copy this file to `.env` and fill in real values for your local machine.
# `.env` is git-ignored and must NEVER be committed.
#
# This file intentionally contains placeholders only — no real credentials.
# ============================================================================

# --- Application environment -------------------------------------------------
# development | staging | production
APP_ENV=development

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- PostgreSQL ----------------------------------------------------------------
# Full SQLAlchemy-style DSN for the job_market_intelligence database created
# in Step 2. The +psycopg driver is assumed; adjust if a different driver is
# chosen in Step 4.
#
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://jmi_app_user:changeme@localhost:5432/job_market_intelligence

# Base connection pool size (Step 4 will tune this further per deployment).
DB_POOL_SIZE=5

# Additional connections allowed beyond DB_POOL_SIZE under burst load.
DB_POOL_MAX_OVERFLOW=10

# ============================================================================
# The following are reserved for FUTURE steps. They are listed here only so
# collaborators know they're coming — do not implement or rely on them yet.
# Actual centralization happens in Step 14 (Configuration Management).
# ============================================================================

# --- Scraping (Step 5+) ---
# SCRAPER_DEFAULT_DELAY_SECONDS=
# SCRAPER_MAX_RETRIES=
# SCRAPER_USER_AGENT=

# --- Scheduler (Step 12) ---
# How often scripts/run_scheduler.py runs the RemoteOK pipeline, in hours.
SCHEDULER_SCRAPE_INTERVAL_HOURS=12
# SCHEDULER_RUN_IMMEDIATELY_ON_START=true
# SCHEDULER_MISFIRE_GRACE_TIME_SECONDS=3600
# SCHEDULER_COALESCE_MISSED_RUNS=true

# Partition maintenance and materialized-view refresh are separate,
# not-yet-built scheduled jobs (see workflow doc) - reserved here so their
# env vars land in the same place once they exist.
# SCHEDULER_PARTITION_MAINTENANCE_CRON=
# SCHEDULER_MV_REFRESH_CRON=

# --- API (Step 34) ---
# API_HOST=
# API_PORT=
# API_SECRET_KEY=

# --- Dashboard (Step 29) ---
# DASHBOARD_PORT=
