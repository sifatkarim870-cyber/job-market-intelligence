{
  "source_code": "104_tw",
  "source_name": "104 Job Bank (Taiwan)",
  "country": "Taiwan",
  "base_url": "https://www.104.com.tw",
  "listing_path": "/jobs/search/",
  "listing_pagination": "?page={page}",
  "max_pages": 4,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href*='/job/']",
  "listing_wait_seconds": 16,
  "detail_ready_selector": "h1",
  "detail_wait_seconds": 15,
  "detail_settle_seconds": 3.0,
  "scroll_count": 2,
  "scroll_pause_seconds": 1.5,
  "uc_mode": true,
  "headless": true,
  "max_detail_pages": 60,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='/job/']",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "employment_type": "#employment_type",
    "skills": ""
  },
  "detail_url_pattern": "^/job/[a-zA-Z0-9]+",
  "id_from_url": true,
  "id_url_regex": "/job/([a-zA-Z0-9]+)",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion"
    ],
    "description": "description",
    "posted_date": "datePosted",
    "employment_type": "employmentType",
    "salary": "baseSalary.value.value"
  },
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "TWD",
  "pay_period": "monthly",
  "country_fallback": "Taiwan"
}
