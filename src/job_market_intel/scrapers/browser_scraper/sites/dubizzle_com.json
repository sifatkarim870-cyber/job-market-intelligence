{
  "source_code": "dubizzle_com",
  "source_name": "Dubizzle Jobs (uae.dubizzle.com) - United Arab Emirates",
  "country": "United Arab Emirates",
  "base_url": "https://uae.dubizzle.com",
  "listing_path": "/jobs/search/",
  "listing_pagination": "?page={page}",
  "max_pages": 10,
  "max_jobs_per_run": 40,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href*='---']",
  "listing_wait_seconds": 20,
  "detail_ready_selector": "h1",
  "detail_wait_seconds": 12,
  "scroll_count": 0,
  "scroll_pause_seconds": 1.5,
  "uc_mode": true,
  "headless": true,
  "challenge_markers": "Request unsuccessful, Incapsula incident",
  "max_detail_pages": 40,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='---']",
    "job_title": "h1[data-testid='job-title']",
    "company": "[data-testid='compnay-name']",
    "location": "[data-testid='location']",
    "description": "[data-testid='description']",
    "posted_date": "[data-testid='job-posted-date']",
    "salary": "[data-testid='salary']",
    "skills": "",
    "employment_type": "[data-testid='commitment']"
  },
  "detail_url_pattern": "/jobs/.+---[0-9a-f]+/?$",
  "id_from_url": true,
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": "jobLocation.address.addressLocality",
    "description": "description",
    "posted_date": "datePosted",
    "salary": "baseSalary.value.value"
  },
  "inter_request_delay_seconds": 2.0
}
