{
  "source_code": "jobat_be",
  "source_name": "Jobat.be (Belgium)",
  "country": "Belgium",
  "base_url": "https://www.jobat.be",
  "listing_path": "/nl/jobs/results",
  "listing_pagination": "?page={page}",
  "max_pages": 4,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href*='/job_']",
  "listing_wait_seconds": 20,
  "detail_ready_selector": "h1",
  "detail_wait_seconds": 15,
  "detail_settle_seconds": 2.0,
  "scroll_count": 2,
  "scroll_pause_seconds": 1.5,
  "uc_mode": true,
  "headless": true,
  "ignore_challenge_markers": "challenge-platform",
  "max_detail_pages": 60,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='/job_']",
    "job_title": "h1",
    "company": "a[itemprop='name']",
    "location": "meta[itemprop='addressLocality']@content",
    "description": ".JobDetails-content",
    "posted_date": "meta[itemprop='datePosted']@content",
    "salary": "#jobdetail [class*='salary']",
    "employment_type": "meta[itemprop='employmentType']@content",
    "skills": ""
  },
  "title_priority": "h1,og:title,title-tag,selector",
  "detail_url_pattern": "",
  "id_from_url": true,
  "id_url_regex": "/job_([0-9]+)$",
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "EUR",
  "pay_period": "monthly",
  "country_fallback": "Belgium"
}
