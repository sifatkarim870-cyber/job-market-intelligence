{
  "source_code": "jobstreet_sg",
  "source_name": "JobStreet (Singapore)",
  "country": "Singapore",
  "base_url": "https://sg.jobstreet.com",
  "listing_path": "/jobs",
  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href*='/job/']",
  "listing_wait_seconds": 20,
  "detail_ready_selector": "h1",
  "detail_wait_seconds": 15,
  "detail_settle_seconds": 2.0,
  "scroll_count": 2,
  "scroll_pause_seconds": 1.5,
  "uc_mode": true,
  "headless": true,
  "max_detail_pages": 60,
  "detail_url_strip_query": true,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='/job/']",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "employment_type": "#employment_type",
    "skills": ""
  },
  "title_priority": "h1,og:title,title-tag,selector",
  "detail_url_pattern": "/job/\\d+$",
  "id_from_url": true,
  "id_url_regex": "/job/(\\d+)$",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressCountry"
    ],
    "description": "description",
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "SGD",
  "pay_period": "monthly",
  "country_fallback": "Singapore"
}
