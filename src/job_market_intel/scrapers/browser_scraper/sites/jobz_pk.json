{
  "source_code": "jobz_pk",
  "source_name": "Jobz.pk (Pakistan)",
  "country": "Pakistan",
  "base_url": "https://www.jobz.pk",
  "listing_path": "/jobs/",
  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href*='_jobs-']",
  "listing_wait_seconds": 20,
  "detail_ready_selector": "#ad-desc-cont",
  "detail_wait_seconds": 15,
  "detail_settle_seconds": 2.0,
  "scroll_count": 2,
  "scroll_pause_seconds": 1.5,
  "uc_mode": true,
  "headless": true,
  "max_detail_pages": 60,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='_jobs-']",
    "job_title": "h1",
    "company": "div.job_detail_cell1:-soup-contains('Organization') + div.job_detail_cell2",
    "location": "div.job_detail_cell1:-soup-contains('Vacancy Location') + div.job_detail_cell2",
    "description": "#ad-desc-cont",
    "posted_date": "div.job_detail_cell1:-soup-contains('Date Posted') + div.job_detail_cell2",
    "salary": "",
    "employment_type": "div.job_detail_cell1:-soup-contains('Job Type') + div.job_detail_cell2",
    "skills": ""
  },
  "title_priority": "h1,og:title,title-tag,selector",
  "detail_url_pattern": "_jobs-\\d+",
  "id_from_url": true,
  "id_url_regex": "_jobs-(\\d+)",
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "PKR",
  "pay_period": "monthly",
  "country_fallback": "Pakistan"
}
