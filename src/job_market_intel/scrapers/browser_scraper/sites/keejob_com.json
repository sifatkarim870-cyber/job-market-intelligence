{
  "source_code": "keejob_com",
  "source_name": "Keejob (keejob.com) - Tunisia",
  "country": "Tunisia",
  "base_url": "https://keejob.com",
  "listing_path": "/offres-emploi/",
  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 40,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href*='/offres-emploi/']",
  "listing_wait_seconds": 12,
  "detail_ready_selector": "",
  "detail_wait_seconds": 10,
  "scroll_count": 3,
  "scroll_pause_seconds": 1.5,
  "uc_mode": true,
  "headless": true,
  "max_detail_pages": 40,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='/offres-emploi/']:not([href*='/entreprises/']):not([href*='/formations/'])",
    "job_title": "h1, h2",
    "company": "[class*='company'], [class*='entreprise'], [class*='recruteur']",
    "location": "[class*='location'], [class*='ville'], [class*='city']",
    "description": "[class*='description'], [class*='detail'], article",
    "posted_date": "[class*='date'], time",
    "salary": "[class*='salary'], [class*='salaire']",
    "skills": "[class*='skill'], [class*='competence']",
    "employment_type": ""
  },
  "title_priority": "h1,og:title,title-tag,selector",
  "detail_url_pattern": "",
  "id_from_url": true,
  "inter_request_delay_seconds": 1.0
}
