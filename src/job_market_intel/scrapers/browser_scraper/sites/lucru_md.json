{
  "source_code": "lucru_md",
  "source_name": "Lucru.md (lucru.md)",
  "country": "Moldova",
  "base_url": "https://www.lucru.md",
  "listing_path": "/ro/lucru-moldova",
  "listing_pagination": "/page-{page}",
  "max_pages": 3,
  "max_jobs_per_run": 50,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href*='/ro/lucru/']",
  "listing_wait_seconds": 25,
  "detail_ready_selector": "h1",
  "detail_wait_seconds": 15,
  "detail_settle_seconds": 1.0,
  "scroll_count": 2,
  "scroll_pause_seconds": 1.5,
  "uc_mode": true,
  "headless": true,
  "challenge_markers": "verify that you're not a robot,enable javascript",
  "max_detail_pages": 50,
  "selectors": {
    "job_card": "div.vacancyCardItem, .previewCard, article",
    "job_link": "a[href*='/ro/lucru/']",
    "job_title": "h1, h2, [class*='title']",
    "company": ".company, .employer, [class*='company']",
    "location": ".location, [class*='location']",
    "description": ".job-description, .description, [class*='description']",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']",
    "employment_type": ""
  },
  "detail_url_pattern": ".*/ro/lucru/.*/[0-9]+$",
  "id_from_url": true,
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "MDL",
  "pay_period": "monthly",
  "country_fallback": "Moldova"
}
