  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href^='/jobs/']",
  "listing_wait_seconds": 12,
  "detail_ready_selector": "h1",
  "detail_wait_seconds": 12,
  "detail_settle_seconds": 1.0,
  "scroll_count": 0,
  "uc_mode": true,
  "headless": true,
  "uc_reconnect_seconds": 4,
  "max_detail_pages": 60,
  "selectors": {
    "job_card": "",
    "job_link": "a[href^='/jobs/']",
    "job_title": "h1",
    "company": ".company__name",
    "location": ".company__address",
    "description": "div.job-description",
    "posted_date": ".posting-details",
    "salary": "table tr:has(th:-soup-contains('Estimated Pay')) td",
    "employment_type": "table tr:has(th:-soup-contains('Hours')) td",
    "skills": ""
  },
  "title_priority": "h1,og:title,title-tag,selector",
  "posted_date_regex": "\\d{4}-\\d{2}-\\d{2}",
  "salary_text_regex": "\\$(?P<min>\\d+(?:\\.\\d+)?)\\s*per\\s+(?P<unit>hour|day|week|month|year)",
  "detail_url_pattern": "",
  "id_from_url": true,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "USD",
  "pay_period": "hourly",
  "country_fallback": "United States"
}
