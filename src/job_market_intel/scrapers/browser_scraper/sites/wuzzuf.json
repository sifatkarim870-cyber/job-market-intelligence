{
  "source_code": "wuzzuf",
  "source_name": "Wuzzuf (Egypt)",
  "country": "Egypt",
  "base_url": "https://wuzzuf.net",
  "listing_path": "/search/jobs",
  "listing_pagination": "?q=&start={zero_page}",
  "max_pages": 6,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "listing_ready_selector": "a[href*='/jobs/p/']",
  "listing_wait_seconds": 20,
  "detail_ready_selector": "h1",
  "detail_wait_seconds": 15,
  "detail_settle_seconds": 2.0,
  "scroll_count": 0,
  "scroll_pause_seconds": 1.5,
  "uc_mode": true,
  "headless": true,
  "uc_reconnect_seconds": 8,
  "ignore_challenge_markers": "challenge-platform",
  "max_detail_pages": 60,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='/jobs/p/']",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "employment_type": "#employment_type",
    "skills": ""
  },
  "title_priority": "h1,og:title,title-tag,selector",
  "detail_url_pattern": "/jobs/p/[a-z0-9]+-[^/]+$",
  "id_from_url": true,
  "id_url_regex": "/jobs/p/([a-z0-9]+)-",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressCountry"
    ],
    "description": "description",
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "EGP",
  "pay_period": "monthly",
  "country_fallback": "Egypt"
}
