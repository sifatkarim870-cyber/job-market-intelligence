{
  "source_code": "518_tw",
  "source_name": "518 \u718a\u73ed (518.com.tw, Taiwan)",
  "country": "Taiwan",
  "base_url": "https://www.518.com.tw",
  "listing_path": "/job-index.html",
  "listing_pagination": "?page={page}",
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "a.job__title",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "employment_type": "#employment_type",
    "skills": ""
  },
  "detail_url_pattern": "/job-[a-z0-9]+\\.html$",
  "id_from_url": true,
  "id_url_regex": "job-([A-Za-z0-9]+)\\.html",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressCountry"
    ],
    "description": [
      "description"
    ],
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "detail_json_salary": {
    "currency": "baseSalary.currency",
    "min": "baseSalary.value.minValue",
    "max": "baseSalary.value.maxValue",
    "unit": "baseSalary.value.unitText"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "TWD",
  "pay_period": "monthly",
  "country_fallback": "Taiwan"
}
