{
  "source_code": "activelink_ie",
  "source_name": "Activelink (activelink.ie, Ireland)",
  "country": "Ireland",
  "base_url": "https://www.activelink.ie",
  "listing_path": "/vacancies",
  "listing_pagination": "?page={offset}",
  "listing_page_size": 1,
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "h2.teaser__title a",
    "job_title": "h1.full__title span.field--name-title",
    "company": "",
    "location": ".general-info__region",
    "description": ".noticeboard-entry__body",
    "posted_date": "time.datetime@datetime",
    "salary": "",
    "employment_type": "",
    "skills": ""
  },
  "detail_url_pattern": "/vacancies/[a-z0-9-]+/\\d+",
  "id_from_url": true,
  "id_url_regex": "/vacancies/[a-z0-9-]+/(\\d+)",
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "EUR",
  "pay_period": "yearly",
  "country_fallback": "Ireland"
}
