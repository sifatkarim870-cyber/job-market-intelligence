{
  "source_code": "bestjobs_eu",
  "source_name": "BestJobs (bestjobs.eu)",
  "country": "Romania",
  "base_url": "https://www.bestjobs.eu",
  "listing_path": "/locuri-de-munca",
  "listing_pagination": "?limit=24&locale=ro&cursor={cursor}",
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "employment_type": "#employment_type",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/loc-de-munca/[^/]+$",
  "id_from_url": true,
  "listing_json_path": "props.pageProps.jobListCardsFromServer.items",
  "listing_json_id_field": "slug",
  "listing_json_url_template": "/loc-de-munca/{id}",
  "listing_json_cursor_path": "props.pageProps.jobListCardsFromServer.nextCursor",
  "detail_json_next_data": true,
  "detail_json_path": "props.pageProps.job",
  "detail_json_map": {
    "title": "title",
    "company": "employer.employerName",
    "location": "locations[].name",
    "employment_type": "employmentTypes",
    "description": [
      "description"
    ],
    "salary": "salary"
  },
  "salary_text_regex": "(?P<min>[0-9]{2,6})(?:\\s*[-–]\\s*(?P<max>[0-9]{2,6}))?\\s*(?P<currency>EUR|RON)?",
  "impersonate": "chrome",
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "extra_headers": {
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "ro-RO,ro;q=0.9,en;q=0.8",
    "Referer": "https://www.bestjobs.eu/locuri-de-munca"
  },
  "request_timeout_seconds": 45,
  "inter_request_delay_seconds": 1.5,
  "currency_iso_code": "EUR",
  "pay_period": "monthly",
  "country_fallback": "Romania"
}