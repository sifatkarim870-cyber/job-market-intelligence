{
  "source_code": "camhr_com",
  "source_name": "CamHR (camhr.com)",
  "country": "Cambodia",
  "base_url": "https://camhr.com",
  "listing_path": "/a/job",
  "listing_pagination": "",
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "listing_json_url": "https://api.camhr.com/v1.0.0/jobs/simple/page-query?page={page}&size=20",
  "listing_json_path": "data.result",
  "listing_json_id_field": "id",
  "listing_json_url_template": "/a/job/{id}",
  "detail_json_url": "https://api.camhr.com/v1.0.0/jobs/{id}",
  "detail_json_map": {
    "title": "data.title",
    "company": "data.employer.company",
    "location": "data.locations[].locationId.label",
    "employment_type": "data.termId.label",
    "description": [
      "data.description",
      "data.requirement"
    ],
    "posted_date": "data.pubdate",
    "salary": "data.salaryId.label"
  },
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "#main-content h1, h1",
    "company": "#company",
    "location": "#location",
    "employment_type": "#employment_type",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "title_priority": "selector",
  "detail_url_pattern": "/a/job/\\d+$",
  "id_from_url": true,
  "user_agent": "job-market-intel-research (research@example.org)",
  "extra_headers": {
    "Accept": "application/json, text/html;q=0.9"
  },
  "request_timeout_seconds": 45,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "USD",
  "pay_period": "monthly",
  "country_fallback": "Cambodia"
}
