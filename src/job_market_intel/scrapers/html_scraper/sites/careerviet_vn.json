{
  "source_code": "careerviet_vn",
  "source_name": "CareerViet (careerviet.vn)",
  "country": "Vietnam",
  "base_url": "https://careerviet.vn",
  "listing_path": "/viec-lam/tat-ca-viec-lam-vi.html",
  "listing_pagination": "?page={page}",
  "max_pages": 5,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": ".job-item",
    "job_link": "a.job_link, a[href*='/tim-viec-lam/']",
    "job_title": "h1, h2, .job-title, [class*='title']",
    "company": ".employer, .job-company-name, [class*='company']",
    "location": ".location, [class*='location']",
    "description": ".job-description, .detail-row, [class*='description']",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*/vi/tim-viec-lam/.*\\.html",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "VND",
  "pay_period": "monthly",
  "country_fallback": "Vietnam"
}
