{
  "source_code": "cpjobs_hk",
  "source_name": "CPJobs (www.cpjobs.com)",
  "country": "Hong Kong",
  "base_url": "https://www.cpjobs.com",
  "listing_path": "/hk/jobs",
  "listing_pagination": "?page={page}",
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "a[href^='/hk/en/job/']",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "",
    "skills": "",
    "employment_type": "#employment_type",
    "education_level": "",
    "experience_level": "",
    "remote_work_type": "",
    "job_category": ""
  },
  "detail_url_pattern": "/hk/en/job/[^/]+-\\d+$",
  "id_from_url": true,
  "id_url_regex": "(\\d+)$",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressCountry"
    ],
    "description": "description",
    "posted_date": "datePosted"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 60,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "HKD",
  "pay_period": "monthly",
  "country_fallback": "Hong Kong"
}
