{
  "source_code": "cv_lt",
  "source_name": "CV.lt (cv.lt)",
  "country": "Lithuania",
  "base_url": "https://www.cv.lt",
  "listing_path": "/jobs",
  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 25,
  "selectors": {
    "job_card": "article",
    "job_link": "article .main-info a, .main-info a",
    "job_title": "h1, h2, [class*='title']",
    "company": "a[href*='imones'], .company, [class*='company']",
    "location": ".location, [class*='location']",
    "description": "main, .job-description, .description",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*-[0-9]{7,}$",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "EUR",
  "pay_period": "monthly",
  "country_fallback": "Lithuania"
}
