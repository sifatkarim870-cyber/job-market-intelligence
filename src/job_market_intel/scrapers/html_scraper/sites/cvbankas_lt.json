{
  "source_code": "cvbankas_lt",
  "source_name": "CVbankas (cvbankas.lt)",
  "country": "Lithuania",
  "base_url": "https://www.cvbankas.lt",
  "listing_path": "/",
  "listing_pagination": "?page={page}",
  "max_pages": 2,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "article",
    "job_link": "article a[href*='/1-']",
    "job_title": "[itemprop='title']",
    "company": "meta[itemprop='name']@content",
    "location": "[itemprop='addressLocality']",
    "description": "[itemprop='description']",
    "posted_date": "meta[itemprop='datePosted']@content",
    "salary": "[class*='salary']",
    "employment_type": "",
    "skills": ""
  },
  "detail_url_pattern": "/[a-z0-9-]+/\\d+-\\d+$",
  "id_from_url": true,
  "id_url_regex": "-(\\d+)$",
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "EUR",
  "pay_period": "monthly",
  "country_fallback": "Lithuania"
}
