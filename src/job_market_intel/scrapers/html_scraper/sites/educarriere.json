{
  "source_code": "educarriere",
  "source_name": "Educarriere",
  "country": "Côte d'Ivoire",
  "base_url": "https://emploi.educarriere.ci",
  "listing_path": "/page/all",
  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "article, .offre, .job-card, .listing-item",
    "job_link": "a[href*='offre-']",
    "job_title": "h1, h2, h3, .job-title, [class*='title']",
    "company": ".company, .employer, [class*='company'], [class*='employer']",
    "location": ".location, [class*='location'], [class*='city'], [class*='place']",
    "description": ".job-description, .description, [class*='description'], .job-body",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*offre-\\d+-.*\\.html",
  "id_from_url": true,
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "XOF",
  "pay_period": "monthly",
  "country_fallback": "Côte d'Ivoire"
}
