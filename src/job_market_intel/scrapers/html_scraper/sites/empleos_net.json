{
  "source_code": "empleos_net",
  "source_name": "Empleos.net (empleos.net)",
  "country": "Costa Rica",
  "base_url": "https://empleos.net",
  "listing_path": "/vacantes",
  "listing_pagination": "?pagelocales={page}",
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "article.xblog-item",
    "job_link": "a[href*='/puesto/']",
    "job_title": "div.xblog-medium-info h3",
    "company": "div.xblog-medium-info h4",
    "location": "h4:-soup-contains('Ubicación del Puesto') + p",
    "description": "div.pr-20.pt-20.pb-20",
    "posted_date": "li.xblog-medium-info-meta-item",
    "salary": "",
    "skills": ""
  },
  "title_priority": "selector,og:title",
  "title_strip_selector": "small",
  "posted_date_regex": "\\d{2}-\\d{2}-\\d{4}",
  "detail_url_pattern": "/puesto/[^/]+$",
  "id_from_url": true,
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "CRC",
  "pay_period": "monthly",
  "country_fallback": "Costa Rica"
}
