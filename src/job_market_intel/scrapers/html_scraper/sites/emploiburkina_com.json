{
  "source_code": "emploiburkina_com",
  "source_name": "Emploi Burkina (emploiburkina.com)",
  "country": "Burkina Faso",
  "base_url": "https://www.emploiburkina.com",
  "listing_path": "/recherche-jobs-burkina-faso",
  "listing_pagination": "?page={page}",
  "max_pages": 4,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='/offre-emploi-burkina-faso/']",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "employment_type": "#employment_type",
    "skills": ""
  },
  "detail_url_pattern": "offre-emploi-burkina-faso/[^/]+",
  "id_from_url": true,
  "id_url_regex": "-([0-9]+)$",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressCountry"
    ],
    "description": [
      "description"
    ],
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 10.0,
  "currency_iso_code": "XOF",
  "pay_period": "monthly",
  "country_fallback": "Burkina Faso"
}
