  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/fr/jobs/\\d+",
  "id_from_url": true,
  "listing_json_url": "https://api-v4.emploipartner.com/api/jobs",
  "listing_json_path": "hydra:member",
  "listing_json_id_field": "id",
