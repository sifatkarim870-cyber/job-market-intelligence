  "detail_json_map": {
    "title": "title",
    "company": "companyName",
    "location": "region.fullName",
    "description": [
      "missionDescription",
      "profileDescription",
      "otherDescription"
    ],
    "posted_date": "publishedDate",
    "salary": "salary"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
