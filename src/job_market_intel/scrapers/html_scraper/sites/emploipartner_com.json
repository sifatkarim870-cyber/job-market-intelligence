{
  "source_code": "emploipartner_com",
  "source_name": "Emploi Partner (emploipartner.com)",
  "country": "Algeria",
  "base_url": "https://www.emploipartner.com",
  "listing_path": "/fr/jobs/search",
  "listing_pagination": "?page={page}",
  "max_pages": 10,
