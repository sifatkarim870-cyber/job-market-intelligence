    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/offers/[^/]+$",
  "id_from_url": true,
  "listing_json_path": "$",
