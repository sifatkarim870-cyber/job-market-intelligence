{
  "source_code": "ethiojobs_et",
  "source_name": "EthioJobs (ethiojobs.net)",
  "country": "Ethiopia",
  "base_url": "https://ethiojobs.net",
  "listing_path": "/jobs",
  "listing_pagination": "?page={page}",
  "max_pages": 5,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "employment_type": "#employment_type",
    "skills": ""
  },
  "detail_url_pattern": "",
  "id_from_url": false,
  "listing_json_path": "props.pageProps.jobs.data",
  "listing_json_id_field": "slug",
  "listing_json_url_template": "/job/{slug}",
  "detail_json_from_listing": true,
  "detail_json_map": {
    "title": "title",
    "company": "company.name",
    "location": [
      "state"
    ],
    "description": [
      "description"
    ],
    "posted_date": "date_published"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 0.5,
  "currency_iso_code": "ETB",
  "pay_period": "monthly",
  "country_fallback": "Ethiopia"
}