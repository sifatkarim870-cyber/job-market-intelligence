{
  "source_code": "fne_cm",
  "source_name": "FNE — Fonds National de l'Emploi (emploi.fnecm.org)",
  "country": "Cameroon",
  "base_url": "https://emploi.fnecm.org",
  "listing_path": "/offres",
  "listing_pagination": "?page={page}&par_page=9",
  "max_pages": 5,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "a[href*='/offre/'], div.card",
    "job_link": "a[href*='/offre/']",
    "job_title": "h1, h2, h3, [class*='title']",
    "company": ".company, .employer, [class*='company']",
    "location": ".location, [class*='location'], [class*='city']",
    "description": "main, div.container, body",
    "posted_date": "[class*='date'], [class*='posted'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], span.badge"
  },
  "detail_url_pattern": ".*/offre/[^/]+$",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "XAF",
  "pay_period": "monthly",
  "country_fallback": "Cameroon"
}
