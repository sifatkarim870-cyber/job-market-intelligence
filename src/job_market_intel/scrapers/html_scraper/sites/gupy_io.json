{
  "source_code": "gupy_io",
  "source_name": "Gupy (gupy.io)",
  "country": "Brazil",
  "base_url": "https://gupy.io",
  "listing_path": "/",
  "listing_pagination": "",
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/job/.+$",
  "id_from_url": true,
  "listing_json_url": "https://portal.gupy.io/api/job-search/jobs?limit=100&offset={offset}&sortBy=publishedDate",
  "listing_page_size": 100,
  "listing_json_path": "data",
  "listing_json_id_field": "id",
  "listing_json_url_field": "jobUrl",
  "detail_json_from_listing": true,
  "detail_json_map": {
    "title": "name",
    "company": "careerPageName",
    "location": [
      "city",
      "state"
    ],
    "description": "description",
    "posted_date": "publishedDate"
  },
  "extra_headers": {
    "Accept": "application/json",
    "Referer": "https://portal.gupy.io/job-search"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 60,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "BRL",
  "pay_period": "monthly",
  "country_fallback": "Brazil"
}
