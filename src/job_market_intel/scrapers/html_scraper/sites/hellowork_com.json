{
  "source_code": "hellowork_com",
  "source_name": "HelloWork (hellowork.com)",
  "country": "France",
  "base_url": "https://www.hellowork.com",
  "listing_path": "/fr-fr/emploi/recherche.html",
  "listing_pagination": "?p={page}",
  "max_pages": 2,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "a[href*='/emplois/'], li, article",
    "job_link": "a[href*='/emplois/']",
    "job_title": "h1, h2, [class*='title']",
    "company": "[class*='company'], [class*='employer']",
    "location": "[class*='location'], [class*='city'], [class*='place']",
    "description": "section, article, main, .job-description, .description, body",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*/fr-fr/emplois/[0-9]+\\.html.*",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "EUR",
  "pay_period": "monthly",
  "country_fallback": "France"
}
