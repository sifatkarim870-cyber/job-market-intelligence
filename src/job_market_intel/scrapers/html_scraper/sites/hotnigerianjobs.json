{
  "source_code": "hotnigerianjobs",
  "source_name": "HotNigerianJobs",
  "country": "Nigeria",
  "base_url": "https://www.hotnigerianjobs.com",
  "listing_path": "/jobs/featured/",
  "listing_pagination": "{page}/",
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": ".fet_show",
    "job_link": "a[href*='/hotjobs/']",
    "job_title": "h1",
    "company": ".company, .employer, [class*='company'], [class*='employer']",
    "location": ".location, [class*='location'], [class*='city'], [class*='place']",
    "description": ".mycase4",
    "posted_date": ".semibio",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": "/hotjobs/\\d+/",
  "id_from_url": true,
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "NGN",
  "pay_period": "monthly",
  "country_fallback": "Nigeria"
}
