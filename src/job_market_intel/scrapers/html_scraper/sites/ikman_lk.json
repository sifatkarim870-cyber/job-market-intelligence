  "listing_pagination": "?page={page}",
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='/en/ad/']",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/en/ad/[a-z0-9-]+$",
  "id_from_url": true,
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": "jobLocation.address.addressLocality",
    "description": [
      "description"
    ],
    "posted_date": "datePosted",
    "salary": "baseSalary.value.minValue"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "LKR",
