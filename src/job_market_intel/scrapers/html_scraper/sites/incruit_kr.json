{
  "source_code": "incruit_kr",
  "source_name": "Incruit (job.incruit.com, South Korea)",
  "country": "South Korea",
  "base_url": "https://job.incruit.com",
  "listing_path": "/jobdb_list/searchjob.asp",
  "listing_pagination": "?today=y&page={page}",
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "a[href*='jobdb_info/jobpost.asp']",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "employment_type": "#employment_type",
    "skills": ""
  },
  "detail_url_pattern": "jobdb_info/jobpost\\.asp\\?job=\\d+",
  "id_from_url": true,
  "id_url_regex": "jobpost\\.asp\\?job=(\\d+)",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressCountry"
    ],
    "description": "description",
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "KRW",
  "pay_period": "monthly",
  "country_fallback": "South Korea"
}
