  "listing_path": "/",
  "listing_pagination": "?page={page}",
  "max_pages": 1,
  "max_jobs_per_run": 12,
  "min_expected_jobs": 2,
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "#courseTitle td.sameSize span.title",
    "company": "h1",
    "location": "#workLocation td.sameSize",
    "description": "#shokushu td.sameSize p",
    "posted_date": "#updateDate",
    "salary": "",
    "skills": "",
    "employment_type": "#employmentStatus .c-label"
  },
  "posted_date_regex": "\\d{4}/\\d{1,2}/\\d{1,2}",
  "detail_url_pattern": "/recruiting_course\\d+/recruiting_course\\.html$",
  "title_priority": "selector,h1",
  "id_url_regex": "recruiting_course(\\d+)/recruiting_course\\.html",
  "id_from_url": true,
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 45,
  "inter_request_delay_seconds": 120.0,
  "currency_iso_code": "JPY",
  "pay_period": "monthly",
  "country_fallback": "Japan"
}
