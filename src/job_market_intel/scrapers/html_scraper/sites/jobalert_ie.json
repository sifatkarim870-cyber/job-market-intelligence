{
  "source_code": "jobalert_ie",
  "source_name": "JobAlert.ie (Ireland)",
  "country": "Ireland",
  "base_url": "https://www.jobalert.ie",
  "listing_path": "/jobs",
  "listing_pagination": "?page={page}",
  "max_pages": 6,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "a[href^='/job/']",
    "job_title": "h1",
    "company": "[itemtype*='JobPosting'] meta[itemprop='hiringOrganization']@content",
    "location": "[itemprop='addressLocality']@content",
    "description": "[itemprop='description']",
    "posted_date": "[itemprop='datePosted']@content",
    "employment_type": "[itemprop='employmentType']@content",
    "salary": "",
    "skills": ""
  },
  "detail_url_pattern": "/job/[a-z0-9-]+$",
  "id_from_url": true,
  "id_url_regex": "/job/([a-z0-9-]+)$",
  "impersonate": "chrome",
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "EUR",
  "country_fallback": "Ireland"
}
