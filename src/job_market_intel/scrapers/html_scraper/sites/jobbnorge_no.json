{
  "source_code": "jobbnorge_no",
  "source_name": "Jobbnorge – public sector (jobbnorge.no)",
  "country": "Norway",
  "base_url": "https://www.jobbnorge.no",
  "listing_path": "/search",
  "listing_pagination": "?OrderBy=Published&Period=All&page={page}",
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/ledige-stillinger/stilling/\\d+$",
  "id_from_url": true,
  "listing_json_url": "https://publicapi.jobbnorge.no/v1/Jobs?results=50&page={zero_page}&orderby=Published&period=All",
  "listing_json_path": "$",
  "listing_json_id_field": "id",
  "listing_json_url_template": "/ledige-stillinger/stilling/{id}",
  "listing_page_size": 50,
  "detail_json_url": "https://id.jobbnorge.no/api/joblisting?jobId={id}&languageId={language}",
  "detail_json_languages": [
    1,
    2,
    3,
    4
  ],
  "detail_json_map": {
    "title": "listing.title",
    "company": "listing.employer",
    "location": "listing.location",
    "description": [
      "components[].text"
    ]
  },
  "extra_headers": {
    "Accept": "application/json"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "NOK",
  "pay_period": "monthly",
  "country_fallback": "Norway"
}
