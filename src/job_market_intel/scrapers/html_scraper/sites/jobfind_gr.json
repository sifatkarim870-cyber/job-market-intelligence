  "listing_path": "/JobAds/all/Athens/GR/Theseis_Ergasias",
  "listing_pagination": "?pageid={page}",
  "max_pages": 5,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "div.jobitem, .jobitem, article",
    "job_link": "a[href*='/JobAd/View/']",
    "job_title": "h1, h2, h3.title, .job-title",
    "company": ".company, .employer, [class*='company']",
    "location": ".location, [class*='location']",
    "description": ".job-description, .description, [class*='description']",
    "posted_date": "[class*='date'], [class*='posted'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*/JobAd/View/.*",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "EUR",
  "pay_period": "monthly",
  "country_fallback": "Greece"
}
