{
  "source_code": "jobthai_com",
  "source_name": "JobThai (jobthai.com)",
  "country": "Thailand",
  "base_url": "https://www.jobthai.com",
  "listing_path": "/th/jobs",
  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "a[href*='/th/company/job/'], div, article",
    "job_link": "a[href*='/th/company/job/']",
    "job_title": "h1, h2, [class*='title']",
    "company": "a[href*='/company/'], [class*='company'], [class*='employer']",
    "location": "[class*='location'], [class*='city'], [class*='place']",
    "description": "main, article, .job-description, .description, body",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*/th/company/job/[0-9]+.*",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "THB",
  "pay_period": "monthly",
  "country_fallback": "Thailand"
}
