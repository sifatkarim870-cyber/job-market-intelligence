{
  "source_code": "jobzella",
  "source_name": "Jobzella",
  "country": "Egypt",
  "base_url": "https://www.jobzella.com",
  "listing_path": "/search/jobs",
  "listing_pagination": "?page={page}",
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "article, div.job-card, div.job-item, .vacancy-card, .listing-item, .card",
    "job_link": "a[href*='/job/'], a[href*='/vacancy/'], a[href*='/listing/'], a[href*='/career/']",
    "job_title": "h1",
    "company": ".MuiTypography-subtitle1",
    "location": ".location, [class*='location'], [class*='city'], [class*='place']",
    "description": "section ul",
    "posted_date": "time, [class*='date'], [class*='posted']",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": "/jobs/\\d+$",
  "id_from_url": true,
  "listing_json_path": "props.pageProps.jobs",
  "listing_json_id_field": "id",
  "listing_json_url_template": "/jobs/{id}",
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "EGP",
  "pay_period": "monthly",
  "country_fallback": "Egypt"
}
