{
  "source_code": "kalibrr_com",
  "source_name": "Kalibrr (kalibrr.com)",
  "country": "Philippines",
  "base_url": "https://www.kalibrr.com",
  "listing_path": "/job-board",
  "listing_pagination": "?page={page}",
  "max_pages": 2,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "a[href*='/jobs/'], div[class*='card'], article",
    "job_link": "a[href*='/jobs/']",
    "job_title": "h1, h2, [class*='title']",
    "company": "a[href*='/c/'], .company, .employer, [class*='company']",
    "location": ".location, [class*='location'], [class*='city'], [class*='place']",
    "description": "main, article, .job-description, .description, body",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*/c/[^/]+/jobs/[0-9]+/.*",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "impersonate": "chrome",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "PHP",
  "pay_period": "monthly",
  "country_fallback": "Philippines"
}
