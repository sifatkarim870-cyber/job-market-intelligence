  "listing_path": "/pracovne-ponuky",
  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "ul.box-offer-list-content li, li",
    "job_link": "a[href^='pracovna-ponuka/'], a[href^='/pracovna-ponuka/']",
    "job_title": "h1, h2, [class*='title']",
    "company": ".company, .employer, [class*='company']",
    "location": ".location, [class*='location'], [class*='city']",
    "description": ".offer-detail-content, .job-description, .description",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
