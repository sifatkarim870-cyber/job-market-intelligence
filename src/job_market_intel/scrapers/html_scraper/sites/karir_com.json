{
  "source_code": "karir_com",
  "source_name": "Karir.com (Indonesia)",
  "country": "Indonesia",
  "base_url": "https://karir.com",
  "listing_path": "/search-lowongan",
  "listing_json_url": "https://gateway2-beta.karir.com/v2/search/opportunities",
  "listing_json_method": "POST",
  "listing_json_body": "{\"limit\":{limit},\"offset\":{offset},\"sort_order\":\"newest\",\"is_opportunity\":true}",
  "listing_page_size": 20,
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 5,
  "listing_json_path": "data.opportunities",
  "listing_json_id_field": "id",
  "listing_json_url_template": "https://karir.com/opportunities/{id}",
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "employment_type": "#employment_type",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "",
    "skills": ""
  },
  "detail_json_selector": "script#__NEXT_DATA__",
  "detail_json_attr": "text",
  "detail_json_path": "props.pageProps.responseData",
  "detail_json_map": {
    "title": "job_position",
    "company": "company_name",
    "location": "location",
    "employment_type": "job_type",
    "description": ["responsibilities", "requirements"],
    "posted_date": "posted_at"
  },
  "posted_date_regex": "\\d{4}-\\d{2}-\\d{2}",
  "detail_url_pattern": "/opportunities/\\d+$",
  "id_from_url": true,
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 45,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "IDR",
  "pay_period": "monthly",
  "country_fallback": "Indonesia"
}
