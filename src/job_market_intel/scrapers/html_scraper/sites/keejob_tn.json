{
  "source_code": "keejob_tn",
  "source_name": "Keejob Tunisia (www.keejob.com)",
  "country": "Tunisia",
  "base_url": "https://www.keejob.com",
  "listing_path": "/offres-emploi/",
  "listing_pagination": "?page={page}",
  "max_pages": 4,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "a[href^='/offres-emploi/']:not([href='/offres-emploi/']):not([href^='/offres-emploi/?']):not([href^='/offres-emploi/entreprises/']):not([href^='/offres-emploi/formations/']):not([href^='/offres-emploi/recherche/']):not([href*='source=search_featured'])",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": "",
    "employment_type": "#employment_type",
    "education_level": "",
    "experience_level": "",
    "remote_work_type": "",
    "job_category": ""
  },
  "detail_url_pattern": "/offres-emploi/\\d+/[^/?#]+",
  "id_from_url": true,
  "id_url_regex": "/offres-emploi/(\\d+)/",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressCountry"
    ],
    "description": "description",
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "detail_json_salary": {
    "currency": "baseSalary.currency",
    "min": "baseSalary.value.minValue",
    "max": "baseSalary.value.maxValue",
    "unit": "baseSalary.value.unitText"
  },
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 60,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "TND",
  "pay_period": "monthly",
  "country_fallback": "Tunisia"
}
