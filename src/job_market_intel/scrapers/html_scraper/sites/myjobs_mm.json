{
  "source_code": "myjobs_mm",
  "source_name": "MyJobs.com.mm (www.myjobs.com.mm)",
  "country": "Myanmar",
  "base_url": "https://www.myjobs.com.mm",
  "listing_path": "/jobs",
  "listing_pagination": "?page={page}",
  "max_pages": 6,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "a[href^='/jobs/']:not([href*='/jobs/in/']):not([href*='/jobs/category/']):not([href*='/jobs/type/'])",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": "",
    "employment_type": "#employment_type",
    "education_level": "",
    "experience_level": "",
    "remote_work_type": "",
    "job_category": ""
  },
  "detail_url_pattern": "/jobs/[^/]+$",
  "id_from_url": true,
  "id_url_regex": "/jobs/([^/]+)$",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressCountry"
    ],
    "description": "description",
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "detail_json_salary": {
    "currency": "baseSalary.currency",
    "min": "baseSalary.value.minValue",
    "max": "baseSalary.value.maxValue",
    "unit": "baseSalary.value.unitText"
  },
  "extra_headers": {
    "Accept": "text/html,application/xhtml+xml"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 60,
  "inter_request_delay_seconds": 0.5,
  "currency_iso_code": "MMK",
  "pay_period": "monthly",
  "country_fallback": "Myanmar"
}
