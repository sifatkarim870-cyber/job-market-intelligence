{
  "source_code": "qatarliving_com",
  "source_name": "Qatar Living Jobs (qatarliving.com)",
  "country": "Qatar",
  "base_url": "https://www.qatarliving.com",
  "listing_path": "/en/jobs/jobs/list",
  "listing_pagination": "?page={page}",
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "a[href*='/jobs/jobs/profile/']",
    "job_link": "a[href*='/jobs/jobs/profile/']",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/en/jobs/jobs/profile/[a-z0-9-]+$",
  "id_from_url": true,
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": "jobLocation.address.addressLocality",
    "description": [
      "description"
    ],
    "posted_date": "datePosted"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "QAR",
  "pay_period": "monthly",
  "country_fallback": "Qatar"
}
