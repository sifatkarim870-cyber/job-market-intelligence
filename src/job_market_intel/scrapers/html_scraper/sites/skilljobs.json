{
  "source_code": "skilljobs",
  "source_name": "Skill.jobs",
  "country": "Bangladesh",
  "base_url": "https://skill.jobs",
  "listing_path": "/browse-jobs",
  "listing_pagination": "?page={page}",
  "max_pages": 2,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "a[href*='/jobs/'], div.job-item, article",
    "job_link": "a[href*='/jobs/']",
    "job_title": "h1, h2, h3, .job-title, [class*='title']",
    "company": ".company, .employer, [class*='company']",
    "location": ".location, [class*='location'], [class*='place']",
    "description": "main, .job-description, .description, [class*='description'], body",
    "posted_date": "[class*='date'], [class*='posted'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*/jobs/[^/]+.*",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "BDT",
  "pay_period": "monthly",
  "country_fallback": "Bangladesh"
}
