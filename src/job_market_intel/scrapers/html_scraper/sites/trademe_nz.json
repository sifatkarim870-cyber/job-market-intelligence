{
  "source_code": "trademe_nz",
  "source_name": "Trade Me Jobs (www.trademe.co.nz)",
  "country": "New Zealand",
  "base_url": "https://www.trademe.co.nz",
  "listing_path": "/a/jobs/search",
  "listing_pagination": "?page={page}",
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "listing_json_selector": "script[type='application/ld+json']",
  "listing_json_attr": "text",
  "listing_json_path": "mentions",
  "listing_json_id_field": "url",
  "listing_json_url_field": "url",
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "",
    "skills": "",
    "employment_type": "#employment_type",
    "education_level": "",
    "experience_level": "",
    "remote_work_type": "",
    "job_category": ""
  },
  "detail_url_pattern": "/listing/\\d+/?$",
  "id_from_url": true,
  "id_url_regex": "/(\\d+)/?$",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressCountry"
    ],
    "description": "description",
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 60,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "NZD",
  "pay_period": "monthly",
  "country_fallback": "New Zealand"
}
