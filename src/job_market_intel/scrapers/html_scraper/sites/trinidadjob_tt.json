{
  "source_code": "trinidadjob_tt",
  "source_name": "Trinidad Jobs (trinidadjob.com)",
  "country": "Trinidad and Tobago",
  "base_url": "https://trinidadjob.com",
  "listing_path": "/jobs/",
  "listing_pagination": "",
  "max_pages": 1,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "listing_json_url": "https://trinidadjob.com/wp-json/wp/v2/job-listings?per_page=100&page={page}",
  "listing_json_path": "",
  "listing_json_id_field": "id",
  "listing_json_url_field": "link",
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": "",
    "employment_type": "#employment_type",
    "education_level": "",
    "experience_level": "",
    "remote_work_type": "",
    "job_category": ""
  },
  "detail_url_pattern": "/job/[^/]+/?$",
  "id_from_url": false,
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": [
      "jobLocation.address",
      "jobLocation.address.addressLocality",
      "jobLocation.address.addressRegion",
      "jobLocation.address.addressCountry"
    ],
    "description": "description",
    "posted_date": "datePosted",
    "employment_type": "employmentType"
  },
  "detail_json_salary": {
    "currency": "baseSalary.currency",
    "min": "baseSalary.value.minValue",
    "max": "baseSalary.value.maxValue",
    "unit": "baseSalary.value.unitText"
  },
  "extra_headers": {
    "Accept": "application/json, text/html"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 60,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "TTD",
  "pay_period": "monthly",
  "country_fallback": "Trinidad and Tobago"
}
