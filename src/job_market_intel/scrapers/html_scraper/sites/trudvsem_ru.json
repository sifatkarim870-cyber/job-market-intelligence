{
  "source_code": "trudvsem_ru",
  "source_name": "Trudvsem / Работа России (trudvsem.ru)",
  "country": "Russia",
  "base_url": "https://trudvsem.ru",
  "listing_path": "",
  "listing_pagination": "",
  "max_pages": 3,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": "",
    "employment_type": "#employment_type",
    "education_level": "",
    "experience_level": "",
    "remote_work_type": "",
    "job_category": ""
  },
  "detail_url_pattern": "",
  "id_from_url": true,
  "id_url_regex": "/vacancy/card/[^/]+/([^/]+)/?$",
  "listing_json_url": "https://opendata.trudvsem.ru/api/v1/vacancies?offset={offset}&limit=50",
  "listing_json_path": "results.vacancies",
  "listing_json_id_field": "vacancy.id",
  "listing_json_url_field": "vacancy.vac_url",
  "listing_page_size": 50,
  "detail_json_from_listing": true,
  "detail_json_map": {
    "title": "vacancy.job-name",
    "company": "vacancy.company.name",
    "location": [
      "vacancy.region.name",
      "vacancy.addresses.address[].location"
    ],
    "description": [
      "vacancy.duty",
      "vacancy.requirements",
      "vacancy.qualification"
    ],
    "posted_date": "vacancy.creation-date",
    "employment_type": "vacancy.schedule"
  },
  "detail_json_salary": {
    "min": "vacancy.salary_min",
    "max": "vacancy.salary_max"
  },
  "min_description_chars": 40,
  "extra_headers": {
    "Accept": "application/json"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 60,
  "inter_request_delay_seconds": 1.0,
  "currency_iso_code": "RUB",
  "pay_period": "monthly",
  "country_fallback": "Russia"
}
