{
  "source_code": "vietnamworks_vn",
  "source_name": "VietnamWorks (Vietnam)",
  "country": "Vietnam",
  "base_url": "https://www.vietnamworks.com",
  "listing_path": "/tim-viec-lam",
  "max_pages": 1,
  "max_jobs_per_run": 60,
  "min_expected_jobs": 1,
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "employment_type": "#employment_type",
    "skills": ""
  },
  "listing_json_path": "props.pageProps.jobsData.bestJobs",
  "listing_json_id_field": "jobId",
  "listing_json_url_field": "url",
  "detail_json_from_listing": true,
  "detail_json_map": {
    "title": "title",
    "company": "company",
    "location": "workingLocations[].cityName",
    "description": [
      "jobDescription",
      "jobRequirement"
    ]
  },
  "detail_url_pattern": "-jv$",
  "impersonate": "chrome",
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 1.0,
  "country_fallback": "Vietnam"
}
