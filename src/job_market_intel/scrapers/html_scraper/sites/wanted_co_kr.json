{
  "source_code": "wanted_co_kr",
  "source_name": "Wanted (wanted.co.kr)",
  "country": "South Korea",
  "base_url": "https://www.wanted.co.kr",
  "listing_path": "/wdlist",
  "listing_pagination": "&offset={offset}",
  "listing_page_size": 20,
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/wd/\\d+$",
  "id_from_url": true,
  "listing_json_url": "https://www.wanted.co.kr/api/v4/jobs?country=kr&job_sort=job.latest_order&years=-1&locations=all&limit=20",
  "listing_json_path": "data",
  "listing_json_id_field": "id",
  "listing_json_url_template": "/wd/{id}",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": "jobLocation.address.addressLocality",
    "description": [
      "description"
    ],
    "posted_date": "datePosted"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "impersonate": "chrome",
  "extra_headers": {
    "Referer": "https://www.wanted.co.kr/wdlist"
  },
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "KRW",
  "pay_period": "monthly",
  "country_fallback": "South Korea"
}
