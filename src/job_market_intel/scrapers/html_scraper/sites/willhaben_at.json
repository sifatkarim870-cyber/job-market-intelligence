{
  "source_code": "willhaben_at",
  "source_name": "Willhaben Jobs (willhaben.at)",
  "country": "Austria",
  "base_url": "https://www.willhaben.at",
  "listing_path": "/jobs/suche",
  "listing_pagination": "?page={page}",
  "max_pages": 2,
  "max_jobs_per_run": 50,
  "selectors": {
    "job_card": "a[href*='/jobs/job/'], div[class*='Card'], article",
    "job_link": "a[href*='/jobs/job/']",
    "job_title": "h1, h2, [class*='title']",
    "company": "a[href*='/jobs/firma/'], [class*='company'], [class*='employer']",
    "location": "[class*='location'], [class*='city'], [class*='address']",
    "description": "article, section, body",
    "posted_date": "[class*='date'], [class*='posted'], [class*='time'], time",
    "salary": "[class*='salary'], [class*='pay']",
    "skills": "[class*='skill'], [class*='tag']"
  },
  "detail_url_pattern": ".*/jobs/job/.*",
  "id_from_url": true,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "EUR",
  "pay_period": "monthly",
  "country_fallback": "Austria"
}
