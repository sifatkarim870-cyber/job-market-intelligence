{
  "source_code": "zaplata_bg",
  "source_name": "Zaplata.bg",
  "country": "Bulgaria",
  "base_url": "https://www.zaplata.bg",
  "listing_path": "/search/?go=1",
  "listing_pagination": "&page={page}",
  "max_pages": 10,
  "max_jobs_per_run": 60,
  "selectors": {
    "job_card": "item",
    "job_link": "item .title a",
    "job_title": "h1",
    "company": "#company",
    "location": "#location",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "detail_url_pattern": "/\\d+/[^/]+/?$",
  "id_from_url": true,
  "id_url_regex": "/(\\d{5,7})/",
  "detail_json_ld": true,
  "detail_json_map": {
    "title": "title",
    "company": "hiringOrganization.name",
    "location": "jobLocation.address.addressLocality",
    "description": [
      "description"
    ],
    "posted_date": "datePosted",
    "salary": "baseSalary.value.minValue"
  },
  "user_agent": "job-market-intel-research (research@example.org)",
  "request_timeout_seconds": 30,
  "inter_request_delay_seconds": 2.0,
  "currency_iso_code": "BGN",
  "pay_period": "monthly",
  "country_fallback": "Bulgaria"
}
