  "detail_json_map": {
    "title": "aviso.titulo",
    "company": "aviso.empresa.denominacion",
    "location": [
      "aviso.localizacion.localidadDetalle",
      "aviso.localizacion.provinciaDetalle"
    ],
    "employment_type": "aviso.tipoTrabajo.nombre",
    "description": "aviso.descripcion",
    "posted_date": "aviso.fechaPublicacion",
    "salary": "ARS {aviso.requisitos.salario.salarioMinimo} - {aviso.requisitos.salario.salarioMaximo} {aviso.requisitos.salario.frecuenciaPago.nombre} ({aviso.requisitos.salario.tipo})"
  },
  "selectors": {
    "job_card": "",
    "job_link": "",
    "job_title": "#main-content h1, h1",
    "company": "#company",
    "location": "#location",
    "employment_type": "#employment_type",
    "description": "#description",
    "posted_date": "#posted_date",
    "salary": "#salary",
    "skills": ""
  },
  "title_priority": "selector",
  "detail_url_pattern": "/empleos/(?:[a-z0-9.\\-]+-)?\\d+\\.html$",
  "id_url_regex": "(?:-|/)(\\d+)\\.html$",
  "id_from_url": true,
  "user_agent": "job-market-intel-research (research@example.org)",
  "extra_headers": {
    "x-site-id": "ZJAR",
    "Accept": "application/json",
    "Origin": "https://www.zonajobs.com.ar",
